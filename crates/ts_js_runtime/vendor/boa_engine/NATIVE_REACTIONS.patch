+    /// Attach host-internal reactions without consulting `constructor` or
+    /// `Symbol.species` on this promise. The result is a native promise in the
+    /// current realm. Unlike [`Self::then`], this is intended for specification
+    /// algorithms such as Web IDL "upon fulfillment/rejection", not application
+    /// calls to `Promise.prototype.then`.
+    ///
+    /// Reactions use the engine's ordinary traced promise jobs and preserve
+    /// fulfillment, rejection, thenable assimilation, and microtask ordering.
+    pub fn then_intrinsic(
+        &self,
+        on_fulfilled: Option<JsFunction>,
+        on_rejected: Option<JsFunction>,
+        context: &mut Context,
+    ) -> JsResult<Self> {
+        let constructor = context.intrinsics().constructors().promise().constructor();
+        let capability = PromiseCapability::new(&constructor, context)?;
+        let result = capability.promise.clone();
+        Promise::perform_promise_then(
+            &self.inner,
+            on_fulfilled,
+            on_rejected,
+            Some(capability),
+            context,
+        );
+        Self::from_object(result)
+    }
